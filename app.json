{
  "expo": {
    "name": "SideFlip - Project Ledger",
    "slug": "sideflip",
    "scheme": "sideflip",
    "owner": "dtyler92",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1917"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sideflip.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "SideFlip uses your camera to take photos of your projects.",
        "NSPhotoLibraryUsageDescription": "SideFlip uses your photo library to attach photos to your projects.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1917"
      },
      "package": "com.sideflip.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "SideFlip uses your photo library to attach photos to your projects.",
          "cameraPermission": "SideFlip uses your camera to take photos of your projects."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5a788085-4849-4264-a346-e459e1bd005d"
      }
    }
  }
}
